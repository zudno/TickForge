# Normaliza saltos de línea a LF en el repositorio y en la copia de trabajo,
# sin importar la configuración core.autocrlf de cada desarrollador.
* text=auto eol=lf

# Scripts de Windows necesitan CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: nunca convertir
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.onnx binary
*.parquet binary
*.db binary
