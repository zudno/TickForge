.env.*
!.env.example
config/local.toml

# Bases de datos y logs locales
*.db
*.db-shm
*.db-wal
/logs/

# Datos y artefactos de ML (los modelos se versionan aparte)
/ml/data/
/ml/.venv/
__pycache__/

# Editores y sistema operativo
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Base de datos local (diario de órdenes, watchlist)
/data/
