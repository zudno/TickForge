# Copia este archivo a .env y completa tus llaves de PAPER trading.
# Nunca uses llaves de cuenta real durante el desarrollo.
TICKFORGE_MODE=paper
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Opcionales
# Símbolos de la watchlist, separados por comas
TICKFORGE_WATCHLIST=AAPL,MSFT,NVDA,AMZN,SPY,QQQ
# Feed de datos: iex (gratuito) o sip (requiere suscripción de pago)
ALPACA_DATA_FEED=iex
# Carpeta de logs (la TUI ocupa la terminal, los logs van a archivo)
TICKFORGE_LOG_DIR=logs
# Nivel de logs: error, warn, info, debug, trace
RUST_LOG=info
