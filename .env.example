# Copia este archivo a .env y completa tus llaves de PAPER trading.
# Nunca uses llaves de cuenta real durante el desarrollo.
TICKFORGE_MODE=paper
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Opcionales
# Símbolos de la watchlist, separados por comas
TICKFORGE_WATCHLIST=AAPL,MSFT,NVDA,AMZN,SPY,QQQ
# Feed de datos: iex (gratuito) o sip (requiere suscripción de pago)
ALPACA_DATA_FEED=iex
# Carpeta de logs (la TUI ocupa la terminal, los logs van a archivo)
TICKFORGE_LOG_DIR=logs
# Nivel de logs: error, warn, info, debug, trace
RUST_LOG=info

# Límites de riesgo (USD y porcentajes). Toda orden los respeta, venga de la TUI o de un modelo.
# Valor máximo de una sola orden
TICKFORGE_MAX_ORDER_NOTIONAL=5000
# Valor máximo de la posición en un símbolo después de la orden
TICKFORGE_MAX_POSITION_NOTIONAL=20000
# Desviación máxima del precio límite respecto al mercado (control de error de dedo)
TICKFORGE_MAX_PRICE_DEVIATION_PCT=5
# Antigüedad máxima de la cotización usada para validar (segundos)
TICKFORGE_MAX_QUOTE_AGE_SECS=15

# Carpeta de la base de datos local (diario de órdenes y watchlist guardada).
# La watchlist guardada tiene prioridad: TICKFORGE_WATCHLIST solo se usa en el primer arranque.
TICKFORGE_DATA_DIR=data
